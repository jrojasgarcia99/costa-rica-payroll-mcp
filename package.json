{
  "name": "costa-rica-payroll-mcp",
  "version": "1.0.0",
  "description": "MCP server for Costa Rica payroll: net salary, employer cost, and current payroll rates (2026)",
  "type": "module",
  "bin": {
    "costa-rica-payroll-mcp": "./build/index.js"
  },
  "files": [
    "build"
  ],
